<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OsuPlayer</AssemblyName>
    <RootNamespace>OsuPlayer.Desktop</RootNamespace>
    <ApplicationIcon>game.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\OsuPlayer.Game\OsuPlayer.Game.csproj" />
    <!-- 「桌面全屏特效」子进程（Avalonia，透明 + 点击穿透 + 置顶）：osu!framework 的窗口做不了透明背景，
         所以最小化时的全屏闪光/星星喷泉由这个独立进程画。
         ReferenceOutputAssembly=false：只作为构建依赖，不引用它的程序集、也不把 Avalonia 的 DLL
         拷进播放器输出目录（播放器输出目录里混入另一套 UI 栈会带来冲突风险）。运行时由
         ExternalOverlayBridge 按相对路径去 ..\osu!avalonia\bin 下找 exe。 -->
    <ProjectReference Include="..\..\osu!avalonia\OsuPlayer.Overlay.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Include="game.ico" />
  </ItemGroup>
  <ItemGroup Label="Models">
    <!-- kiai 帧分类器只有 12KB，直接随程序发布到 <输出目录>/models/kiai（KiaiAssets 会优先用
         %APPDATA%\OsuPlayer\models\kiai 里的重新训练版本覆盖它）。 -->
    <Content Include="models\kiai\kiai.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\kiai\config.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 全局 BPM 层级模型（Ballroom 698 首真值训练），同样只有几 KB。 -->
    <Content Include="models\bpm\bpm.onnx" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\bpm\config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>